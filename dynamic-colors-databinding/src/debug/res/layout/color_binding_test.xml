<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable name="role" type="io.github.lucf15.dynamiccolors.ColorRole" />
        <variable name="dark" type="java.lang.Boolean" />
    </data>
    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ffffff"
        android:textColor="#123456"
        app:dynamicTextColor="@{role}"
        app:dynamicTextColorFallback="@{0}"
        app:dynamicBackgroundTint="@{role}"
        app:dynamicDarkTheme="@{dark}" />
</layout>
